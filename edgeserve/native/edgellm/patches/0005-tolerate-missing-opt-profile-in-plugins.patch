+/*!
+ * @brief Copy plugin tensor descriptors, using the profile maximum where the optimum is missing
+ *
+ * TensorRT 10.3 leaves DynamicPluginTensorDesc::opt empty (nbDims == 0) when it configures V3 plugins, so
+ * per-profile shape checks would reject every profile. Returns an empty vector on allocation failure, in
+ * which case callers keep the original descriptors.
+ */
+inline std::vector<nvinfer1::DynamicPluginTensorDesc> withProfileOpt(
+    nvinfer1::DynamicPluginTensorDesc const* descs, int32_t count) noexcept
+{
+    std::vector<nvinfer1::DynamicPluginTensorDesc> result;
+    if (descs == nullptr || count <= 0)
+    {
+        return result;
+    }
+    try
+    {
+        result.assign(descs, descs + count);
+    }
+    catch (...)
+    {
+        result.clear();
+        return result;
+    }
+    for (auto& desc : result)
+    {
+        if (desc.opt.nbDims == 0 && desc.max.nbDims > 0)
+        {
+            desc.opt = desc.max;
+        }
+    }
+    return result;
+}
