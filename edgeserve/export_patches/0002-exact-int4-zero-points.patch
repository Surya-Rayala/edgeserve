+# The int4 GEMM kernel computes ``(nibble - 8) * scale`` and has no zero-point input. Folding an
+# asymmetric zero point into the nibbles (``nibble - zero + 8``) clips every code that then leaves
+# [0, 15]. Instead, the nibbles are kept as they are and the rest of the weight,
+# ``(8 - zero) * scale``, is added by a small per-group GEMM (``zp_correction``, see linear.py):
+#     (nibble - zero) * scale = (nibble - 8) * scale + (8 - zero) * scale
+# EDGELLM_FOLD_ZERO_POINTS=1 restores the folding.
+_EXACT_ZERO_POINTS = os.environ.get("EDGELLM_FOLD_ZERO_POINTS", "") != "1"
+
+
+def awq_zero_points(qzeros: torch.Tensor, out_features: int) -> torch.Tensor:
+    """AWQ ``qzeros`` ``[in//g, out//8]`` int32 -> zero points ``[in//g, out]`` int32."""
+    qz = qzeros.cpu().to(torch.int32)
+    zeros = torch.zeros(qz.shape[0], out_features, dtype=torch.int32)
+    for k, channel in enumerate([0, 2, 4, 6, 1, 3, 5, 7]):  # AutoAWQ's nibble order
+        zeros[:, channel::8] = (qz >> (4 * k)) & 0xF
+    return zeros
+
+
+def gptq_zero_points(qzeros: torch.Tensor, out_features: int, num_groups: int,
+                     zero_point_offset: int) -> torch.Tensor:
+    """GPTQ ``qzeros`` ``[groups, out//8]`` int32 -> actual zero points ``[groups, out]`` int32 (8 when the
+    checkpoint stores none)."""
+    qz = qzeros.cpu().to(torch.int32)
+    if qz.numel() == 0:
+        return torch.full((num_groups, out_features), 8, dtype=torch.int32)
+    zeros = torch.zeros(qz.shape[0], out_features, dtype=torch.int32)
+    for k in range(8):
+        zeros[:, k::8] = (qz >> (4 * k)) & 0xF
+    return zeros + int(zero_point_offset)
+
+
+def zero_point_correction(zeros: torch.Tensor, scales: torch.Tensor,
+                          group_size: int) -> torch.Tensor:
+    """``(8 - zero) * scale * group_size`` ``[groups, out]`` float16: multiplied by the per-group mean of the
+    activations, it adds the zero-point part of each weight."""
+    return ((8 - zeros).to(torch.float32) * scales.cpu().to(torch.float32) *
+            group_size).to(torch.float16)
+
+
