+def _zero_point_term(hidden_states: torch.Tensor, correction: torch.Tensor,
+                     group_size: int) -> torch.Tensor:
+    """The zero-point part of asymmetric INT4 weights (see ``checkpoint/repacking.py``): the per-group mean of
+    the activations (in float32, so large activations cannot overflow) times ``(8 - zero) * scale * group``."""
+    means = hidden_states.float().unflatten(
+        -1, (hidden_states.shape[-1] // group_size, group_size)).mean(-1)
+    return torch.matmul(means.to(torch.float16), correction)
+
